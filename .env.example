POSTGRES_USER
POSTGRES_PASSWORD
DATABASE_URL
JWT_SECRET

# Workers (producer/consumer), optional overrides
# INTERNAL_KEY          # shared secret workers send to /monitoring/* (required by docker-compose.cloudworkers.yml)
# REDIS_URL             # e.g. rediss://default:<token>@<host>:6379 (Upstash)
# PRODUCER_INTERVAL_SEC # seconds between monitoring sweeps            (default 300)
# CONSUMER_POLL_SEC     # seconds between idle stream polls            (default 60)
# CONSUMER_RECLAIM_INTERVAL_SEC  # seconds between XAUTOCLAIM passes   (default 300)