# StatusBus kubeadm provisioning variables.
# Copy to gcp-infra/k8s/variables.env and fill in your values.
# No secrets live here (those come from Secret Manager at VM boot time).

# Project + regions
PROJECT_ID=statusbus-app-1ek8
CLUSTER_ZONE=asia-south1-a
US_ZONE=us-central1-a
SUBNET=default
NETWORK_TAG=statusbus-k8s

# Compute
MACHINE_TYPE=e2-small
IMAGE_FAMILY=ubuntu-2204-lts
IMAGE_PROJECT=ubuntu-os-cloud
BOOT_DISK_SIZE=30
CLUSTER_WORKER_COUNT=2

# Workload wiring
API_URL=https://api-statusbus.byaniket.site
CONSUMER_IMAGE=asia-south1-docker.pkg.dev/statusbus-app-1ek8/statusbus/statusbus-consumer:latest